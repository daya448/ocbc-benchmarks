{
    "settings": {
        "index.default_pipeline": "set_id_pipeline",
        "index.refresh_interval": "-1",
        "index.number_of_replicas": 0,
        "index.number_of_shards": 2,
        "analysis": {
            "filter": {
                "english_stop": {
                    "type": "stop",
                    "stopwords": "_english_"
                },
                "english_possessive_stemmer": {
                    "type": "stemmer",
                    "language": "possessive_english"
                }
            },
            "analyzer": {
                "english_nostem": {
                    "type": "custom",
                    "tokenizer": "standard",
                    "filter": [
                        "english_possessive_stemmer",
                        "lowercase",
                        "english_stop"
                    ]
                }
            }
        }
    },
    "mappings": {
        "_source": {
            "excludes": [ "emb" ]
        },
        "properties": {
            "docid": {
                "type": "keyword"
            },
            "emb": {
                "type": "dense_vector",
                "element_type": "float",
                "dims": 1024,
                "index": true,
                "similarity": "dot_product",
                "index_options": {
                    "type": "hnsw"
                }
            },
            "text": {
                "type": "text",
                "copy_to": "full_text",
                "analyzer": "standard",
                "fields": {
                    "english": {
                        "type": "text",
                        "analyzer": "english"
                    },
                    "english_nostem": {
                        "type": "text",
                        "analyzer": "english_nostem"
                    }
                }
            },
            "title": {
                "type": "text",
                "copy_to": "full_text",
                "analyzer": "standard",
                "fields": {
                    "english": {
                        "type": "text",
                        "analyzer": "english"
                    },
                    "english_nostem": {
                        "type": "text",
                        "analyzer": "english_nostem"
                    }
                }
            },
            "full_text": {
                "type": "text",
                "analyzer": "standard",
                "fields": {
                    "english": {
                        "type": "text",
                        "analyzer": "english"
                    },
                    "english_nostem": {
                        "type": "text",
                        "analyzer": "english_nostem"
                    }
                }
            }
        }
    }
}