{
    "name": "index-1m",
    "default": false,
    "description": "Add 1m docs before next search",
    "schedule": [
      {
        "operation": {
          "name": "index-1m",
          "operation-type": "bulk",
          "corpora": "msmarco-memory-1",
          "bulk-size": {{initial_indexing_bulk_size | default(500)}},
          "ingest-percentage": 100
        },
        "clients": {{ initial_indexing_bulk_indexing_clients | default(4) | int }}
      },
      {
        "name": "refresh-after-incremental-load-1M",
        "operation": {
          "operation-type": "refresh"
        }
      }
    ]
  }
