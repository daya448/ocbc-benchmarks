{
  "name": "run-benchmark",
  "default": true,
  "description": "Challenge to delete index, run initial and incremental ingestion, refresh index, and perform search benchmarks.",
  "schedule": [
    {
      "name": "delete-benchmark-index",
      "operation": {
        "operation-type": "delete-index",
        "index": "vdb910-memory-benchmark"
      }
    },
    {
      "name": "check-cluster-health",
      "operation": {
        "operation-type": "check-cluster-health"
      }
    },
    {
      "name": "initial-documents-indexing-6M",
      "operation": "initial-documents-indexing",
      "clients": {{ initial_indexing_bulk_indexing_clients | default(2) | int }}
    },
    {
      "name": "refresh-after-initial-ingestion",
      "operation": {
        "operation-type": "refresh"
      }
    },
    {
      "name": "search-benchmark-after-initial-load-6M",
      "operation": "knn-search-10-100-20",
      "target-throughput": 50,
      "clients": {{ standalone_search_clients | default(2) | int }},
      "iterations": {{ standalone_search_iterations | default(10000) | int }}
    }{% for i in range(1, 9) %},
    {
      "name": "incremental-load-{{i}}M",
      "operation": "incremental-load-{{i}}",
      "clients": {{ initial_indexing_bulk_indexing_clients | default(1) | int }}
    },
    {
      "name": "refresh-after-incremental-load-{{i}}M",
      "operation": {
        "operation-type": "refresh"
      }
    },
    {
      "name": "search-benchmark-after-incremental-load-{{i}}M",
      "operation": "knn-search-10-100-20",
      "target-throughput": 50,
      "clients": {{ standalone_search_clients | default(4) | int }},
      "warmup-time-period": 120,
      "time-period": 300
    }{% endfor %}
  ]
}
